{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lemmata",
  "version": "0.1.0",
  "identifier": "io.github.stepanvanzuriak.lemmata",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A local research canvas where AI agents work on problems with you",
    "longDescription": "Lemmata is a local research canvas. A Prover agent splits a goal into hypotheses and proves or refutes them, a Referee checks the proofs, and Python and Lean cards run real checks. Everything stays on your machine.",
    "copyright": "Copyright (c) 2026 Stepan Vanzuriak",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/lemmata-node"],
    "resources": {
      "resources/daemon/": "daemon/",
      "resources/web/": "web/"
    },
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-libav"]
      }
    }
  }
}
