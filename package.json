{
  "name": "lemmata",
  "version": "0.1.0",
  "private": true,
  "description": "A local research canvas where AI agents work on problems with you",
  "license": "MIT",
  "author": "Stepan Vanzuriak",
  "homepage": "https://stepanvanzuriak.github.io/lemmata/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepanvanzuriak/lemmata.git"
  },
  "bugs": {
    "url": "https://github.com/stepanvanzuriak/lemmata/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "yarn workspaces foreach --all --parallel --interlaced run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "yarn workspaces foreach --all --exclude lemmata --parallel run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "yarn format:check && yarn lint && yarn typecheck",
    "prepare": "husky",
    "desktop:build": "yarn workspace desktop build",
    "version:check": "node scripts/version.mjs check"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "resolutions": {
    "katex": "^0.19.0"
  }
}
